  "description": "把本机所有大模型桌面端软件的思考过程具像化为实时桌面壁纸",
  "type": "module",
  "main": "server/index.mjs",
  "scripts": {
    "start": "node server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "links": "node scripts/links.mjs",
    "simulate": "node scripts/simulate.mjs",
    "simulate:transition": "node scripts/simulate-transition.mjs",
    "backfill": "node scripts/backfill-today.mjs",
    "demo": "node scripts/demo.mjs",
    "test:e2e": "node scripts/e2e-test.mjs",
    "release:check": "node scripts/release-check.mjs",
    "build:pkg": "bash scripts/build-pkg.sh",
    "build:win": "bash scripts/build-win.sh"
